# Frontend Service Environment Variables
# Internal Docker URL for Next.js server-side reverse proxy rewrites (keeps API backend hidden from public)
BACKEND_INTERNAL_URL=http://backend:8000

# Leave NEXT_PUBLIC_API_URL empty for relative API requests (/api/v1/...) via reverse proxy
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_KEYCLOAK_URL=http://keycloak:8080
NEXT_PUBLIC_KEYCLOAK_REALM=homelab
